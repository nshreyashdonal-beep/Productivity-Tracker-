<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Productivity Tracker" Height="720" Width="920" MinWidth="560" MinHeight="480"
        Background="#F6F1E4" FontFamily="Consolas">

    <Window.Resources>
        <!-- Sidebar icon vector data (replaces Segoe MDL2 Assets font glyphs) -->
        <StreamGeometry x:Key="CollapseMenuIcon">M3,5 L21,5 M3,12 L21,12 M3,19 L21,19</StreamGeometry>
        <StreamGeometry x:Key="DashboardIcon">M3,3 L10,3 L10,10 L3,10 Z M13,3 L21,3 L21,10 L13,10 Z M3,13 L10,13 L10,21 L3,21 Z M13,13 L21,13 L21,21 L13,21 Z</StreamGeometry>
        <StreamGeometry x:Key="FocusIcon">M8,5 L19,12 L8,19 Z</StreamGeometry>
        <StreamGeometry x:Key="ExportIcon">M9,16 L9,4 L15,4 L15,16 M5,12 L12,19 L19,12 M4,21 L20,21</StreamGeometry>
        <StreamGeometry x:Key="SwitchIcon">M7,16 L3,12 L7,8 M17,8 L21,12 L17,16 M3,12 L14,12 M10,12 L21,12</StreamGeometry>
        <StreamGeometry x:Key="BackupIcon">M4,12 C4,7.58 7.58,4 12,4 C16.42,4 20,7.58 20,12 C20,16.42 16.42,20 12,20 M12,16 L12,8 M8,12 L12,16 L16,12</StreamGeometry>
        <StreamGeometry x:Key="ArchiveIcon">M3,3 L21,3 L21,21 L3,21 Z M7,7 L17,7 L17,10 L7,10 Z M3,13 L21,13 M10,10 L10,17 L14,17 L14,10</StreamGeometry>

        <!-- Top button style -->
        <Style x:Key="TopBtnStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6,10,6"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2B3A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2B3A55"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBF3DE"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#F0E6C8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar subitem button style -->
        <Style x:Key="SubItemStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5,8,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#5A6B8C"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SubItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBF3DE"/>
                    <Setter Property="Foreground" Value="#2B3A55"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#F0E6C8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar section (header/leaf) hover+active style, applied to the Border wrappers.
             Purely visual (rounded hover pill); does not change x:Name, click routing,
             or the code-behind's Background swaps for the active-section highlight. -->
        <Style x:Key="SidebarItemStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="8,2,8,0"/>
            <Style.Triggers>
                <!-- Only applies while no local Background is set (i.e. the section isn't
                     the active one) — code-behind's active-state Background assignment is
                     a local value and always wins over this trigger, so active highlighting
                     is unaffected. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBF3DE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Scrollbar styling (implicit: applies to every ScrollBar, incl. the ScrollViewers') -->
        <Style TargetType="Thumb">
            <Setter Property="Background" Value="#2B3A55"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6B8C"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="#5A6B8C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                            </Grid.RowDefinitions>
                            <Border Background="#E8DFC8" CornerRadius="5" Margin="1"/>
                            <!-- Up arrow -->
                            <RepeatButton Grid.Row="0" Command="ScrollBar.LineUpCommand"
                                          Background="Transparent" BorderThickness="0"
                                          Focusable="False" IsHitTestVisible="True">
                                <Path Data="M3,7 L6,4 L9,7" Stroke="#2B3A55" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="6" Height="5" Stretch="Uniform"/>
                            </RepeatButton>
                            <!-- Track -->
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                            <!-- Down arrow -->
                            <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand"
                                          Background="Transparent" BorderThickness="0"
                                          Focusable="False" IsHitTestVisible="True">
                                <Path Data="M3,3 L6,6 L9,3" Stroke="#2B3A55" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="6" Height="5" Stretch="Uniform"/>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2B3A55" BorderThickness="1.5" CornerRadius="8" Margin="10" Background="#F6F1E4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===================== HEADER ===================== -->
            <StackPanel x:Name="HeaderStack" Grid.Row="0" Margin="16,16,20,0">
                <TextBlock Text="PRODUCTIVITY TRACKER" FontSize="19" FontWeight="Bold" Foreground="#2B3A55"/>
                <TextBlock x:Name="JourneyNameText" Text="" FontSize="13" Foreground="#5A6B8C"
                           Margin="0,2,0,12" Visibility="Collapsed"/>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="CreateJourneyBtn" Content="CREATE NEW JOURNEY" MinWidth="120" Margin="0,0,8,6" Style="{StaticResource TopBtnStyle}"/>
                    <Button x:Name="EditTemplateBtn" Content="EDIT TEMPLATE" MinWidth="95" Margin="0,0,8,6" Visibility="Collapsed" Style="{StaticResource TopBtnStyle}"/>
                    <Button x:Name="AddDayBtn" Content="+ ADD DAY" MinWidth="90" Margin="0,0,8,6" Visibility="Collapsed" Style="{StaticResource TopBtnStyle}"/>
                    <Button x:Name="BulkDeleteToggleBtn" Content="SELECT" MinWidth="60" Margin="0,0,8,6" Visibility="Collapsed" Style="{StaticResource TopBtnStyle}"/>
                    <Button x:Name="SyncBtn" Content="SYNC" MinWidth="55" Margin="0,0,8,6" Style="{StaticResource TopBtnStyle}"/>
                    <TextBlock x:Name="SyncStatusText" Text="Not synced yet" FontSize="11" Foreground="#5A6B8C"
                               VerticalAlignment="Center" Margin="6,0,0,6"/>
                </WrapPanel>
                <StackPanel x:Name="BulkDeleteBanner" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
                    <TextBlock x:Name="BulkDeleteCountText" Text="" FontFamily="Consolas" FontSize="11"
                               Foreground="#5A6B8C" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="BulkDeleteConfirmBtn" Content="DELETE SELECTED (0)" Padding="10,4"
                            Margin="0,0,8,0" Style="{StaticResource TopBtnStyle}"/>
                    <Button x:Name="BulkDeleteCancelBtn" Content="EXIT SELECT" Padding="10,4"
                            Style="{StaticResource TopBtnStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- ===================== HEADER DIVIDER LINE ===================== -->
            <Border x:Name="HeaderDivider" Grid.Row="1" BorderBrush="#2B3A55" BorderThickness="0,1.5,0,0" Margin="16,16,20,8"/>

            <!-- ===================== BODY: SIDEBAR | SPLITTER | CONTENT AREA ===================== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="190" MinWidth="52" MaxWidth="260"/>
                    <ColumnDefinition x:Name="SidebarSplitterCol" Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- - SIDEBAR - -->
                <StackPanel x:Name="Sidebar" Grid.Column="0" Margin="0">

                    <!-- Collapse / expand toggle -->
                    <Border x:Name="CollapseSidebarBtn" Padding="16,8,16,8" Cursor="Hand"
                            BorderBrush="#2B3A55" BorderThickness="0,0,0,1.5" ToolTip="Collapse sidebar">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="CollapseIcon" Grid.Column="0" Data="{StaticResource CollapseMenuIcon}" Stroke="#2B3A55" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="CollapseLabel" Grid.Column="1" Text="COLLAPSE" FontSize="12" FontWeight="Bold"
                                       Foreground="#2B3A55" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Dashboard section -->
                    <Border x:Name="DashboardHeaderBtn" Style="{StaticResource SidebarItemStyle}" Padding="16,8,16,8" Cursor="Hand" ToolTip="Dashboard">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="DashboardIcon" Grid.Column="0" Data="{StaticResource DashboardIcon}" Stroke="#2B3A55" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="DashboardLabel" Grid.Column="1" Text="DASHBOARD" FontSize="12" FontWeight="Bold"
                                       Foreground="#2B3A55" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="DashboardSubs" Margin="28,2,0,4">
                        <Button x:Name="FilterAllBtn" Content="All" Style="{StaticResource SubItemStyle}"/>
                        <Button x:Name="FilterCompletedBtn" Content="Completed" Style="{StaticResource SubItemStyle}"/>
                        <Button x:Name="FilterMissedBtn" Content="Missed" Style="{StaticResource SubItemStyle}"/>
                        <Button x:Name="ReportBtn" Content="Report / Analytics" Style="{StaticResource SubItemStyle}"/>
                    </StackPanel>

                    <!-- Focus Mode (leaf) -->
                    <Border x:Name="FocusModeBtn" Style="{StaticResource SidebarItemStyle}" Padding="16,8,16,8" Cursor="Hand" ToolTip="Focus mode">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="FocusIcon" Grid.Column="0" Data="{StaticResource FocusIcon}" Stroke="#2B3A55" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="FocusLabel" Grid.Column="1" Text="FOCUS MODE" FontSize="12" FontWeight="Bold"
                                       Foreground="#2B3A55" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Export section -->
                    <Border x:Name="ExportHeaderBtn" Style="{StaticResource SidebarItemStyle}" Padding="16,8,16,8" Cursor="Hand" ToolTip="Export">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="ExportIcon" Grid.Column="0" Data="{StaticResource ExportIcon}" Stroke="#2B3A55" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="ExportLabel" Grid.Column="1" Text="EXPORT" FontSize="12" FontWeight="Bold"
                                       Foreground="#2B3A55" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="ExportSubs" Margin="28,2,0,4" Visibility="Collapsed">
                        <Button x:Name="ExportBtn" Content="Export" Style="{StaticResource SubItemStyle}"/>
                    </StackPanel>

                    <!-- Switch Journey section -->
                    <Border x:Name="SwitchJourneyBtn" Style="{StaticResource SidebarItemStyle}" Padding="16,8,16,8" Cursor="Hand" ToolTip="Switch journey">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="SwitchIcon" Grid.Column="0" Data="{StaticResource SwitchIcon}" Stroke="#2B3A55" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="SwitchLabel" Grid.Column="1" Text="SWITCH JOURNEY" FontSize="12" FontWeight="Bold"
                                       Foreground="#2B3A55" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="SwitchJourneySubs" Margin="28,2,0,4" Visibility="Collapsed">
                        <StackPanel x:Name="SwitchJourneyListPanel"/>
                    </StackPanel>

                    <!-- Backup & Restore section -->
                    <Border x:Name="BackupHeaderBtn" Style="{StaticResource SidebarItemStyle}" Padding="16,8,16,8" Cursor="Hand" ToolTip="Backup &amp; restore">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="BackupIcon" Grid.Column="0" Data="{StaticResource BackupIcon}" Stroke="#2B3A55" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="BackupLabel" Grid.Column="1" Text="BACKUP" FontSize="12" FontWeight="Bold"
                                       Foreground="#2B3A55" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="BackupSubs" Margin="28,2,0,4" Visibility="Collapsed">
                        <Button x:Name="SetBackupFolderBtn" Content="Set Backup Folder" Style="{StaticResource SubItemStyle}"/>
                        <Button x:Name="ImportBtn" Content="Import" Style="{StaticResource SubItemStyle}"/>
                    </StackPanel>

                    <!-- Load Archive (leaf) -->
                    <Border x:Name="LoadArchiveBtn" Style="{StaticResource SidebarItemStyle}" Padding="16,8,16,8" Cursor="Hand" ToolTip="Load archive">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="ArchiveIcon" Grid.Column="0" Data="{StaticResource ArchiveIcon}" Stroke="#2B3A55" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="ArchiveLabel" Grid.Column="1" Text="LOAD ARCHIVE" FontSize="12" FontWeight="Bold"
                                       Foreground="#2B3A55" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- - SPLITTER - -->
                <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                               Background="#E8DFC8" ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize sidebar">
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2B3A55"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>

                <!-- - CONTENT AREA - -->
                <Grid Grid.Column="2" Margin="18,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="ReadOnlyBanner" Grid.Row="0" BorderBrush="#B8860B" BorderThickness="1.5"
                            Background="#FBF3DE" Padding="10" Margin="0,0,0,14" Visibility="Collapsed" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ReadOnlyBannerText" Text="Viewing archived journey (read-only)"
                                       Foreground="#5A3E00" VerticalAlignment="Center" FontSize="12"/>
                            <Button x:Name="BackToCurrentBtn" Content="BACK TO CURRENT" Width="130" Margin="16,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="StartJourneyPanel" Grid.Row="1" BorderBrush="#2B3A55" BorderThickness="1.5"
                            Background="#FFFFFF" Padding="20" Margin="0,18,22,20" Visibility="Collapsed"
                            VerticalAlignment="Top" CornerRadius="6" Panel.ZIndex="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.18" Color="#2B3A55"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="JourneyPanelTitle" Text="SET UP YOUR JOURNEY" FontSize="13" FontWeight="Bold" Foreground="#2B3A55" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="JOURNEY NAME" Foreground="#5A6B8C" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" Width="120"/>
                                <TextBox x:Name="JourneyNameBox" Width="280" FontFamily="Consolas" Padding="8,6"/>
                            </StackPanel>

                            <StackPanel x:Name="JourneyDateRow" Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="START DATE" Foreground="#5A6B8C" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" Width="120"/>
                                <DatePicker x:Name="JourneyDatePicker" Width="180" Padding="8,6"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="GOALS" Foreground="#5A6B8C" FontSize="11" Margin="0,4,12,0" Width="120"/>
                                <WrapPanel x:Name="GoalEditPanel"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="ADD GOAL (HOURS)" Foreground="#5A6B8C" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" Width="120"/>
                                <TextBox x:Name="NewGoalHoursBox" Width="60" FontFamily="Consolas" Padding="6"/>
                                <Button x:Name="AddGoalBtn" Content="+" Width="32" Margin="8,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="These goals stay fixed for the whole journey." FontSize="10" Foreground="#5A6B8C"
                                       FontStyle="Italic" Margin="132,0,0,18"/>

                            <StackPanel Orientation="Horizontal" Margin="132,0,0,0">
                                <Button x:Name="SetTemplateBtn" Content="SET TEMPLATE FOR JOURNEY" Width="180" Margin="0,0,10,0"/>
                                <Button x:Name="CancelJourneyBtn" Content="CANCEL" Width="70" Background="#FFFFFF" BorderBrush="#2B3A55" BorderThickness="1" Foreground="#5A6B8C"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Days list (Dashboard view, also used for read-only archive viewing).
                         Virtualized with Standard mode (not Recycling) so scrolling is
                         smooth — containers are kept alive and content is updated in place
                         instead of being destroyed/rebuilt on every scroll. Keyboard
                         navigation (arrow keys) is enabled for smooth scrolling. -->
                    <Grid x:Name="DaysScrollViewer" Grid.Row="1" Panel.ZIndex="1">
                        <ListBox x:Name="DaysList"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Focusable="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Standard"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock x:Name="EmptyStateText" Text="No entries yet." Foreground="#5A6B8C"
                                   FontSize="12" FontStyle="Italic" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"
                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Info area (Export confirmation / Switch confirm / Load Archive picker) -->
                    <ScrollViewer x:Name="InfoAreaScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel x:Name="InfoAreaPanel" Margin="4"/>
                    </ScrollViewer>

                    <!-- Focus Mode view -->
                    <Border x:Name="FocusModePanel" Grid.Row="1" Visibility="Collapsed" Panel.ZIndex="2">
                        <StackPanel MaxWidth="440" HorizontalAlignment="Center" Margin="0,28,22,0">
                            <!-- Maximize toggle: hides the sidebar + header so the Focus view
                                 takes the whole window (distraction-free). See Toggle-FocusMaximize. -->
                            <Button x:Name="FocusMaximizeBtn" Content="MAXIMIZE" MinWidth="96"
                                    Style="{StaticResource TopBtnStyle}" HorizontalAlignment="Right"
                                    Margin="0,0,0,14" ToolTip="Hide sidebar and header for a distraction-free focus view"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Button x:Name="FocusPomoBtn" Content="POMO" Style="{StaticResource TopBtnStyle}" Margin="0,0,8,0" MinWidth="90"/>
                                <Button x:Name="FocusStopBtn" Content="STOPWATCH" Style="{StaticResource TopBtnStyle}" MinWidth="110"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,18">
                                <TextBox x:Name="FocusLabelBox" FontFamily="Consolas" FontSize="12" TextAlignment="Center"
                                         Padding="8,8,8,8" BorderBrush="#2B3A55" BorderThickness="1"
                                         Background="#FFFFFF" Foreground="#2B3A55"/>
                                <TextBlock x:Name="FocusLabelHint" Text="What are you focusing on? (optional)"
                                           FontFamily="Consolas" FontSize="12" Foreground="#5A6B8C"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>

                            <Border x:Name="FocusTimerCircle" Width="220" Height="220" CornerRadius="110"
                                    BorderBrush="#C9BFA5" BorderThickness="2" HorizontalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.12" Color="#2B3A55"/>
                                </Border.Effect>
                                <TextBlock x:Name="FocusTimerText" Text="25:00" FontFamily="Consolas" FontSize="42"
                                           FontWeight="Bold" Foreground="#2B3A55" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Inline Pomodoro duration editor: opens on timer-circle click while idle. -->
                            <StackPanel x:Name="FocusDurationEditPanel" Visibility="Collapsed"
                                        HorizontalAlignment="Center" Margin="0,14,0,0">
                                <TextBlock Text="Duration: 5~180 mins" FontFamily="Consolas" FontSize="11"
                                           Foreground="#5A6B8C" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBox x:Name="FocusDurationBox" Width="70" FontFamily="Consolas" FontSize="14"
                                             TextAlignment="Center" Padding="6,4" Margin="0,0,8,0"/>
                                    <Button x:Name="FocusDurationOkBtn" Content="OK" MinWidth="54"
                                            Style="{StaticResource TopBtnStyle}" Margin="0,0,8,0"/>
                                    <Button x:Name="FocusDurationCancelBtn" Content="Cancel" MinWidth="70"
                                            Style="{StaticResource TopBtnStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="FocusButtonPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,22,0,0"/>

                            <TextBlock x:Name="FocusLogTargetText" FontFamily="Consolas" FontSize="11" Foreground="#5A6B8C"
                                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
